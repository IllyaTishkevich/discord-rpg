<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>discord-rpg — Admin</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            background: #1e1f22;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
        }
        .card {
            background: #2b2d31;
            border-radius: 12px;
            padding: 40px;
            text-align: center;
            width: 320px;
        }
        h1 { font-size: 20px; margin-bottom: 24px; }
        .error {
            background: #f23f42;
            color: #fff;
            border-radius: 8px;
            padding: 10px;
            margin-bottom: 16px;
            font-size: 14px;
        }
        a.google {
            display: inline-block;
            background: #5865f2;
            color: #fff;
            text-decoration: none;
            padding: 10px 20px;
            border-radius: 8px;
            font-size: 15px;
        }
    </style>
</head>
<body>
    <div class="card">
        <h1>discord-rpg — Admin</h1>
        {% for message in app.flashes('error') %}
            <div class="error">{{ message }}</div>
        {% endfor %}
        <a class="google" href="{{ path('admin_login_google') }}">Войти через Google</a>
    </div>
</body>
</html>

DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Optional: set during development to register commands to a single guild instantly
DISCORD_GUILD_ID=
BACKEND_API_URL=http://localhost:8000/api
BOT_API_SECRET=changeme-bot-secret
# Real-time PvP duel sync relay (bot/src/realtime/server.js) — port this
# process listens on for the backend's publish calls and the Activity's own
# WebSocket connections (proxied through nginx as /ws, see docs/PRODUCTION_SETUP.md).
WS_PORT=3002
